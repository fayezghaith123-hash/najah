PORT=3000
NODE_ENV=development
# سلسلة عشوائية طويلة (32 حرفًا على الأقل): node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# العنوان العام الذي يفتحه الطلاب ويُوضع داخل QR (HTTPS في الإنتاج)
BASE_URL=http://localhost:3000
# على الاستضافة: مسار داخل القرص الدائم مثل /var/data/attendance.db
DB_PATH=attendance.db
# 15 = من يسجّل بعد 15 دقيقة من البدء يصبح متأخرًا (0 = معطّل)
LATE_AFTER_MINUTES=0

# الحسابات المسموح لها بالدخول
DOCTOR_EMAIL=abuhijleh@najah.edu
EXTRA_ALLOWED_EMAILS=fayezghaith123@gmail.com

# البريد (لإرسال رمز التفعيل). اختر واحدًا. في التطوير بدونه يُطبع الرمز في الطرفية.
# الخيار 1 (مستحسن على Render): Brevo عبر HTTPS
BREVO_API_KEY=
MAIL_FROM=
# الخيار 2: SMTP (مثلًا Gmail بكلمة مرور تطبيقات)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
